rules_version = '2';
// Paste this into Firebase console: Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function mail() { return request.auth.token.email.lower(); }
    function verified() { return request.auth.token.email_verified == true; }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }

    // a pointer from each Google account to its family
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // an invite is addressed to one email; only that person can read it, and only parents can create it
    match /invites/{email} {
      allow read: if signedIn() && verified() && mail() == email;
      allow create, update: if signedIn() && isMember(request.resource.data.family);
      allow delete: if signedIn() && ((verified() && mail() == email) || isMember(resource.data.family));
    }

    match /families/{fid} {
      function invitedHere() {
        return signedIn() && verified()
          && exists(/databases/$(database)/documents/invites/$(mail()))
          && get(/databases/$(database)/documents/invites/$(mail())).data.family == fid;
      }
      allow read: if signedIn() && (request.auth.uid in resource.data.members || invitedHere());
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (invitedHere()
            && request.auth.uid in request.resource.data.members
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1));
    }
  }
}
